# Added to the shared Caddyfile on the VPS (before the final loopback block), using the same shared snippets as the
# neighbouring sites. Caddy reaches the container by its compose service name on edge-net.
#
# No Content-Security-Policy and no HSTS here on purpose: apps/api sends its own strict set (helmet), and a second,
# different CSP from the proxy would be intersected with it and break things quietly.
burrow.woofi-developments.at {
    encode zstd gzip

    # FR-017's cap is enforced by the API (MAX_UPLOAD_MB, default 200); this is the outer wall, a little above it, so
    # the API's own 413 with a readable message wins for ordinary oversize files.
    request_body {
        max_size 220MB
    }

    header {
        -Server
    }

    # Only the sign-in page and the legal pages may be indexed; share links, the API and every signed-in view stay out.
    @private not path / /impressum /privacy /terms
    header @private X-Robots-Tag "noindex, nofollow"

    import access_log
    import error_pages

    reverse_proxy burrow:8080 {
        import edge_upstream_errors
        # A large upload on a slow line must not be cut off mid-body.
        transport http {
            read_timeout 10m
            write_timeout 10m
        }
    }
}

# Optional second listener, only for upload pieces. In the global options at the top of the Caddyfile add
#     servers :8443 { protocols h1 }
# so this port speaks HTTP/1.1 only: the browser then opens several connections instead of squeezing every piece onto
# one HTTP/2 or HTTP/3 connection (about 22 against 12 Mbit/s on a home line). Set UPLOAD_ORIGIN to
# https://burrow.woofi-developments.at:8443 in /opt/burrow/.env. Nothing but the pieces and the health check is
# forwarded here.
burrow.woofi-developments.at:8443 {
    request_body {
        max_size 220MB
    }

    header {
        -Server
    }

    import access_log
    import error_pages

    handle /livez {
        reverse_proxy burrow:8080
    }

    @piece path_regexp piece ^/api/uploads/[0-9a-f-]{36}/chunks/[0-9]+$
    handle @piece {
        reverse_proxy burrow:8080 {
            import edge_upstream_errors
            transport http {
                read_timeout 10m
                write_timeout 10m
            }
        }
    }

    handle {
        respond 404
    }
}
