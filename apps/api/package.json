{
  "name": "@burrow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Main application server: auth, profiles, the category tree, file metadata and the scheduler that calls apps/vision for bulk sorting.",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "node --env-file-if-exists=.env --watch --experimental-strip-types src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --env-file-if-exists=.env.test --experimental-strip-types --test-concurrency=1 --test",
    "database:migrate": "node --env-file-if-exists=.env scripts/run-migrations.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "argon2": "^0.45.1",
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.23.1",
    "@types/yauzl": "^3.4.0"
  }
}
