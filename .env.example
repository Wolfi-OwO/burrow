# Copied to .env and read by docker-compose.yml for local development of
# the full stack (postgres + apps/api + apps/vision together). Neither
# apps/api nor apps/vision exists yet — this file documents the env surface
# the scaffolding is planned around, not what any running code reads today.

# Secret used to sign session JWTs. The default below is fine for local
# development only — generate a real one with `openssl rand -base64 48`
# for anything that isn't your own machine.
JWT_SECRET=local-dev-only-jwt-secret-do-not-use-in-production

# OIDC login (GitHub/Microsoft/Google) — optional. Leave unset for a
# credential-only login/register page with no provider buttons.
OAUTH_FRONTEND_BASE_URL=http://localhost:8080
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Where apps/api reaches the vision service for bulk-sort jobs.
VISION_SERVICE_URL=http://vision:8000
