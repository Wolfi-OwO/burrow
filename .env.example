# Copied to .env and read by docker-compose.yml for local development of the full stack
# (postgres + apps/api + apps/vision). Production values live in /opt/burrow/.env on the server; see
# organizational/deploy/README.md. Never commit a real .env.

# Signs access tokens. Generate a real one with `openssl rand -base64 48`; the API refuses anything under 32 characters.
JWT_SECRET=local-dev-only-jwt-secret-do-not-use-in-production

# Browser origins allowed to call the API cross-origin, comma-separated. No wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Upload cap in MB (FR-017) and the per-IP login attempt cap per 15 minutes (FR-002).
MAX_UPLOAD_MB=200
# A .zip upload is unpacked; these bound what one archive may contain.
# Optional second origin that serves only HTTP/1.1, used for upload pieces. A browser puts everything for one origin on a
# single HTTP/2 or HTTP/3 connection, which carries about half of a slow uplink; HTTP/1.1 opens several. Empty means the
# pieces go to the page's own origin. Setup: organizational/deploy/README.md.
# UPLOAD_ORIGIN=https://burrow.example.org:8443

# The assistant chat talks to a llama.cpp server (organizational/deploy/README.md). Unset: the chat is switched off.
# LLM_SERVICE_URL=http://127.0.0.1:8090
# Generations at the same time (the model runs on the CPU), the longest answer in tokens, and messages per minute.
# LLM_CONCURRENCY=1
# LLM_MAX_TOKENS=450
# CHAT_RATE_LIMIT_MAX=12

# An S3-compatible object store (Contabo Object Storage, Backblaze B2, MinIO, ...) as the store of record for the files. Unset: files live only on
# this machine's disk. Set: every file is also written there before an upload counts as stored. With BLOB_CACHE_GB the disk
# becomes a cache of the recently used files (the rest is fetched back on use); without it everything stays on disk too.
# Setup (Contabo Object Storage, EU): organizational/deploy/README.md.
# S3_ENDPOINT=https://eu2.contabostorage.com
# S3_REGION=eu2
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PART_MB=64
# Encrypt every file before it is sent to the bucket (openssl rand -base64 32). Keep a copy apart from the server: without it
# the bucket's files cannot be read by anyone. Set it before the first upload to the bucket.
# BLOB_ENCRYPTION_KEY=
# BLOB_CACHE_GB=40

# What one account may store (GB, 0 = no limit), and the free space the disk must keep (GB; only enforced in
# production). An account's own limit can be set in the database: UPDATE users SET quota_bytes = ... (0 = no limit).
# USER_QUOTA_GB=25
# DISK_RESERVE_GB=10

# Import from a link: the server downloads a file itself. Switch it off, or cap the size and the imports per account.
# IMPORT_ENABLED=true
# IMPORT_MAX_GB=10
# IMPORT_MAX_PER_USER=2

# ZIP_MAX_ENTRIES=5000
# ZIP_MAX_TOTAL_MB=32768
# Big files go up in pieces, written straight into place; these bound them.
# MAX_FILE_GB=20
# UPLOAD_CHUNK_MB=16
LOGIN_RATE_LIMIT_MAX=10

# OIDC login (GitHub / Microsoft / Google). Optional: a provider without an id and secret is simply not offered.
OAUTH_FRONTEND_BASE_URL=http://localhost:8080
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Where uploads live. The local directory is the store of record (ADR-0006); production bind-mounts /opt/burrow/data.
# BLOB_DIR=./data
# The object store settings are explained above (S3_*, BLOB_CACHE_GB).

# Production only: the registry and the shared secrets.
# REGISTRY=
# IMAGE_TAG=
# POSTGRES_PASSWORD=
# METRICS_TOKEN=
# INTERNAL_SERVICE_TOKEN=

# Sorting. The thresholds are named, tunable values (FR-035): below AUTO_FILE_THRESHOLD a file goes to review;
# at or above NSFW_THRESHOLD it may never be auto-filed into a category that can be previewed publicly (FR-037).
# AUTO_FILE_THRESHOLD=0.6
# NSFW_THRESHOLD=0.5
# SCHEDULER_MIN_RUNS_PER_DAY=10
# SCHEDULER_MAX_RUNS_PER_DAY=30
