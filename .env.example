# Copied to .env and read by docker-compose.yml for local development of the full stack
# (postgres + apps/api + apps/vision). Production values live in /opt/burrow/.env on the server; see
# organizational/deploy/README.md. Never commit a real .env.

# Signs access tokens. Generate a real one with `openssl rand -base64 48`; the API refuses anything under 32 characters.
JWT_SECRET=local-dev-only-jwt-secret-do-not-use-in-production

# Browser origins allowed to call the API cross-origin, comma-separated. No wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# burrow is single-tenant: registration closes once the owner exists, unless this is true.
REGISTRATION_OPEN=false

# Upload cap in MB (FR-017) and the per-IP login attempt cap per 15 minutes (FR-002).
MAX_UPLOAD_MB=200
LOGIN_RATE_LIMIT_MAX=10

# OIDC login (GitHub / Microsoft / Google). Optional: a provider without an id and secret is simply not offered.
OAUTH_FRONTEND_BASE_URL=http://localhost:8080
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Production only: Backblaze B2 as the store of record (ADR-0002), the registry, and the shared secrets.
# Set the four B2 values together or not at all; without them the local disk is the only tier.
# B2_ENDPOINT=
# B2_REGION=
# B2_BUCKET=
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# REGISTRY=
# IMAGE_TAG=
# POSTGRES_PASSWORD=
# METRICS_TOKEN=
# INTERNAL_SERVICE_TOKEN=

# Sorting. The thresholds are named, tunable values (FR-035): below AUTO_FILE_THRESHOLD a file goes to review;
# at or above NSFW_THRESHOLD it may never be auto-filed into a category that can be previewed publicly (FR-037).
# AUTO_FILE_THRESHOLD=0.6
# NSFW_THRESHOLD=0.5
# SCHEDULER_MIN_RUNS_PER_DAY=10
# SCHEDULER_MAX_RUNS_PER_DAY=30
